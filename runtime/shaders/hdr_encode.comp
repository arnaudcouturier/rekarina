#version 450
// HDR10 encode on the present (runtime/vk_hdr.c vk_hdr_encode): the game's picture, crop rectangle at offset, linear
// Rec. 709 with the HUD's white at 1.0 (an sRGB view decodes the 8-bit window texture), into an RGBA16F image of PQ
// code values in Rec. 2020 that FSR 1 or the blit then scale into the HDR10 swapchain. p.x: nits of 1.0, p.y: the
// display's peak in nits, p.z: 1 when the source holds sRGB-encoded values in a UNORM format.
// The colour profile (q.x 1; vk_color.c, the same four values as the SDR pass shaders/color_grade.comp): the SDR pass
// grades sRGB code values of a picture whose white is 1.0, so here the linear picture is taken relative to its own
// white (q.y, the picture's white against 1.0), given sRGB code values by the sRGB curve continued above 1 (highlights
// above the white become codes above 1), graded with color_grade.comp's formulas in its order without the clamp to 1,
// and decoded by the same curve: a value at or under the white grades as on SDR, a highlight follows the same curves.
// PQ: SMPTE ST 2084; the Rec. 709 to Rec. 2020 matrix: ITU-R BT.2087. The probe (color_probe.c) holds a CPU copy of
// these formulas.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    ivec2 offset;
    ivec2 size;
    vec4 p;
    vec4 adj;   // brightness (added), contrast, saturation, gamma (exponent)
    vec4 q;     // x: 1 to grade, y: the picture's white against 1.0
} pc;

vec3 srgb_decode(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045)));
}

vec3 srgb_encode(vec3 c) {   // c >= 0; continues above 1
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, greaterThan(c, vec3(0.0031308)));
}

vec3 grade(vec3 c) {
    vec3 e = srgb_encode(c / pc.q.y);
    e += pc.adj.x;
    e = (e - 0.5) * pc.adj.y + 0.5;
    e = mix(vec3(dot(e, vec3(0.2126, 0.7152, 0.0722))), e, pc.adj.z);
    e = pow(max(e, vec3(0.0)), vec3(pc.adj.w));
    return srgb_decode(e) * pc.q.y;
}

vec3 pq(vec3 nits) {
    const float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;
    vec3 y = pow(clamp(nits / 10000.0, 0.0, 1.0), vec3(m1));
    return pow((c1 + c2 * y) / (1.0 + c3 * y), vec3(m2));
}

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(at, pc.size))) return;
    vec3 c = max(texelFetch(src, at + pc.offset, 0).rgb, vec3(0.0));
    if (pc.p.z > 0.5) c = srgb_decode(clamp(c, 0.0, 1.0));
    if (pc.q.x > 0.5) c = grade(c);
    const mat3 to2020 = mat3(0.6274, 0.0691, 0.0164, 0.3293, 0.9195, 0.0880, 0.0433, 0.0114, 0.8956);
    vec3 nits = min(max(to2020 * c, vec3(0.0)) * pc.p.x, vec3(pc.p.y));
    imageStore(dst, at, vec4(pq(nits), 1.0));
}
