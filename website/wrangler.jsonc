// rekarina.dev: a static site served as Cloudflare Workers static assets (no Worker code runs).
// Deploy: npx wrangler deploy   (from this folder; public/_headers and public/_redirects are applied by Cloudflare)
{
  "name": "rekarina-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // The workers.dev address carries the account's own subdomain, so it stays off: the site is reached through its
  // domain only.
  "workers_dev": false,
  "preview_urls": false,
  // Cloudflare creates the DNS records and the certificates for these itself.
  "routes": [
    { "pattern": "rekarina.dev", "custom_domain": true },
    { "pattern": "www.rekarina.dev", "custom_domain": true }
  ]
}
