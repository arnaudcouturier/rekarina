+using Ryujinx.Graphics.Shader.IntermediateRepresentation;
+using Ryujinx.Graphics.Shader.StructuredIr;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using static Spv.Specification;
+
+namespace Ryujinx.Graphics.Shader.CodeGen.Spirv
+{
+    using SpvInstruction = Spv.Generator.Instruction;
+    using SpvLiteralInteger = Spv.Generator.LiteralInteger;
+    using SpvModule = Spv.Generator.Module;
+
+    // TOTK: the VK_EXT_mesh_shader entry point of an NVN2 task or mesh shader (MeshStage). The Ampere code is translated as a compute
+    // kernel whose stage memory is its shared memory (seedds/nxnative's lowering); its main function becomes a plain function this entry
+    // point calls, as nxnative's dm/gfx/tools/dmsh_meshstage.py to_stage (MIT) calls it from a Metal object or mesh function:
+    //   1. the stage memory starts at zero; under a task, the payload is copied to the input (the kernel's own prologue, Translator
+    //      EmitMeshStagePrologue, then puts the workgroup number in);
+    //   2. the kernel runs; an early EXIT returns here;
+    //   3. a task copies its output payload to the TaskPayloadWorkgroupEXT block and launches output word 1 mesh workgroups; a mesh shader
+    //      sets its outputs: max_vertices vertices, the primitive count byte (primitive bytes + 3) primitives, each vertex's attribute
+    //      words from its block of 32 (a word per component, the SPH's OMAP order; a component the shader does not have reads 0, w 1)
+    //      and three index bytes per triangle from the primitive bytes + 4.
+    // The module is SPIR-V 1.4 (SPV_EXT_mesh_shader needs it), so the entry point lists every global variable.
+    static class MeshStageWrapper
+    {
+        // At most this many mesh workgroups from one task workgroup (Vulkan's maxMeshWorkGroupCount[0] is at least 65535)
+        private const int MaxTaskLaunch = 65535;
+
+        public static void Generate(CodeGenContext context, SpvInstruction body, MeshStage mesh)
+        {
+            SpvInstruction u32 = context.TypeU32();
+            SpvInstruction f32 = context.TypeFP32();
+            SpvInstruction vec4 = context.TypeVector(f32, 4);
+            SpvInstruction boolType = context.TypeBool();
+            SpvInstruction voidType = context.TypeVoid();
+            SpvInstruction sharedPtr = context.TypePointer(StorageClass.Workgroup, u32);
+
+            if (!context.SharedMemories.TryGetValue(mesh.SharedMemoryId, out SpvInstruction shared))
+            {
+                throw new InvalidOperationException("task or mesh shader without its stage memory");
+            }
+
+            SpvInstruction C(int v) => context.Constant(u32, v);
+
+            // The payload a task writes and its mesh shaders read
+            SpvInstruction payload = null;
+            SpvInstruction payloadPtr = context.TypePointer(SpvModule.StorageClassTaskPayloadWorkgroupEXT, u32);
+
+            if (mesh.IsTask || mesh.HasTask)
+            {
+                SpvInstruction payloadType = context.TypeArray(u32, C(Math.Max(1, mesh.PayloadWords)));
+                payload = context.Variable(context.TypePointer(SpvModule.StorageClassTaskPayloadWorkgroupEXT, payloadType), SpvModule.StorageClassTaskPayloadWorkgroupEXT);
+                context.AddGlobalVariable(payload);
+                context.Name(payload, "payload");
+            }
+
+            // A mesh shader's outputs: the vertices' positions (in a per-vertex block), their generic attributes (Location n, as a vertex
+            // shader's outputs) and the triangles' indices
+            SpvInstruction perVertex = null, indices = null;
+            List<(int Location, SpvInstruction Variable)> attributes = new(), primitiveAttributes = new();
+            Dictionary<int, int[]> components = new(), primitiveComponents = new();
+
+            if (!mesh.IsTask)
+            {
+                SpvInstruction perVertexType = context.TypeStruct(true, vec4);
+                context.Decorate(perVertexType, Decoration.Block);
+                context.MemberDecorate(perVertexType, 0, Decoration.BuiltIn, (SpvLiteralInteger)BuiltIn.Position);
+                SpvInstruction perVertexArray = context.TypeArray(perVertexType, C(mesh.MaxVertices));
+                perVertex = context.Variable(context.TypePointer(StorageClass.Output, perVertexArray), StorageClass.Output);
+                context.AddGlobalVariable(perVertex);
+                context.Name(perVertex, "mesh_vertices");
+
+                SpvInstruction indexArray = context.TypeArray(context.TypeVector(u32, 3), C(mesh.MaxPrimitives));
+                indices = context.Variable(context.TypePointer(StorageClass.Output, indexArray), StorageClass.Output);
+                context.Decorate(indices, Decoration.BuiltIn, (SpvLiteralInteger)SpvModule.BuiltInPrimitiveTriangleIndicesEXT);
+                context.AddGlobalVariable(indices);
+                context.Name(indices, "mesh_indices");
+
+                // component index in the attribute area of attribute a (-1: the position), x..w
+                for (int i = 0; i < mesh.VertexComponents.Length; i++)
+                {
+                    int c = mesh.VertexComponents[i];
+                    int attr = c < 0 ? -1 : c >> 2;
+                    int comp = c < 0 ? -1 - c : c & 3;
+
+                    if (!components.TryGetValue(attr, out int[] slots))
+                    {
+                        components[attr] = slots = [-1, -1, -1, -1];
+                    }
+
+                    slots[comp] = i;
+                }
+
+                foreach (int attr in components.Keys.Where(a => a >= 0).OrderBy(a => a))
+                {
+                    SpvInstruction array = context.TypeArray(vec4, C(mesh.MaxVertices));
+                    SpvInstruction variable = context.Variable(context.TypePointer(StorageClass.Output, array), StorageClass.Output);
+                    context.Decorate(variable, Decoration.Location, (SpvLiteralInteger)attr);
+                    context.AddGlobalVariable(variable);
+                    context.Name(variable, $"mesh_attr{attr}");
+                    attributes.Add((attr, variable));
+                }
+
+                // per-primitive attributes: their components follow the vertex components in each block (Location n, PerPrimitiveEXT; the
+                // fragment shader's inputs there must carry PerPrimitiveEXT too)
+                for (int i = 0; i < mesh.PrimitiveComponents.Length; i++)
+                {
+                    int c = mesh.PrimitiveComponents[i];
+
+                    if (!primitiveComponents.TryGetValue(c >> 2, out int[] slots))
+                    {
+                        primitiveComponents[c >> 2] = slots = [-1, -1, -1, -1];
+                    }
+
+                    slots[c & 3] = mesh.VertexComponents.Length + i;
+                }
+
+                foreach (int attr in primitiveComponents.Keys.OrderBy(a => a))
+                {
+                    SpvInstruction array = context.TypeArray(vec4, C(mesh.MaxPrimitives));
+                    SpvInstruction variable = context.Variable(context.TypePointer(StorageClass.Output, array), StorageClass.Output);
+                    context.Decorate(variable, Decoration.Location, (SpvLiteralInteger)attr);
+                    context.Decorate(variable, Decoration.PerPrimitiveNV);   // PerPrimitiveEXT, the same value
+                    context.AddGlobalVariable(variable);
+                    context.Name(variable, $"mesh_prim_attr{attr}");
+                    primitiveAttributes.Add((attr, variable));
+                }
+            }
+
+            SpvInstruction lidVariable = FindInput(context, IoVariable.ThreadId);
+
+            SpvInstruction functionType = context.TypeFunction(voidType, false);
+            SpvInstruction entry = context.Function(voidType, FunctionControlMask.MaskNone, functionType);
+            context.AddFunction(entry);
+            context.AddLabel(context.Label());
+
+            SpvInstruction counter = context.Variable(context.TypePointer(StorageClass.Function, u32), StorageClass.Function);
+            context.AddLocalVariable(counter);
+
+            SpvInstruction lid = context.CompositeExtract(u32, context.Load(context.TypeVector(u32, 3), lidVariable), 0);
+
+            SpvInstruction Shared(SpvInstruction wordIndex) => context.AccessChain(sharedPtr, shared, wordIndex);
+
+            void Barrier()
+            {
+                context.ControlBarrier(
+                    context.Constant(u32, Scope.Workgroup),
+                    context.Constant(u32, Scope.Workgroup),
+                    context.Constant(u32, MemorySemanticsMask.WorkgroupMemory | MemorySemanticsMask.AcquireRelease));
+            }
+
+            // for (i = lid; i < end; i += threads) body(i)
+            void Loop(SpvInstruction end, Action<SpvInstruction> loopBody)
+            {
+                context.Store(counter, lid);
+
+                SpvInstruction header = context.Label();
+                SpvInstruction check = context.Label();
+                SpvInstruction bodyLabel = context.Label();
+                SpvInstruction next = context.Label();
+                SpvInstruction merge = context.Label();
+
+                context.Branch(header);
+                context.AddLabel(header);
+                context.LoopMerge(merge, next, LoopControlMask.MaskNone);
+                context.Branch(check);
+                context.AddLabel(check);
+                SpvInstruction i = context.Load(u32, counter);
+                context.BranchConditional(context.ULessThan(boolType, i, end), bodyLabel, merge);
+                context.AddLabel(bodyLabel);
+                loopBody(context.Load(u32, counter));
+                context.Branch(next);
+                context.AddLabel(next);
+                context.Store(counter, context.IAdd(u32, context.Load(u32, counter), C(mesh.Threads)));
+                context.Branch(header);
+                context.AddLabel(merge);
+            }
+
+            int words = mesh.Size / 4;
+            int input = mesh.Offsets[1] / 4, output = mesh.Offsets[2] / 4, primitives = mesh.Offsets[3];
+
+            Loop(C(words), i => context.Store(Shared(i), C(0)));
+            Barrier();
+
+            if (!mesh.IsTask && mesh.HasTask)
+            {
+                Loop(C(mesh.PayloadWords), i => context.Store(Shared(context.IAdd(u32, i, C(input))), context.Load(u32, context.AccessChain(payloadPtr, payload, i))));
+                Barrier();
+            }
+
+            context.FunctionCall(voidType, body);
+            Barrier();
+
+            if (mesh.IsTask)
+            {
+                Loop(C(mesh.PayloadWords), i => context.Store(context.AccessChain(payloadPtr, payload, i), context.Load(u32, Shared(context.IAdd(u32, i, C(output))))));
+                Barrier();
+
+                SpvInstruction launch = context.GlslUMin(u32, context.Load(u32, Shared(C(output + 1))), C(MaxTaskLaunch));
+                context.EmitMeshTasksEXT(launch, C(1), C(1), payload);
+            }
+            else
+            {
+                SpvInstruction count = context.GlslUMin(u32, context.ShiftRightLogical(u32, context.Load(u32, Shared(C(primitives / 4))), C(24)), C(mesh.MaxPrimitives));
+
+                context.SetMeshOutputsEXT(C(mesh.MaxVertices), count);
+
+                int stride = Math.Max(mesh.VertexComponents.Length + mesh.PrimitiveComponents.Length, 1) * MeshStage.Block;
+                SpvInstruction outVec4 = context.TypePointer(StorageClass.Output, vec4);
+
+                SpvInstruction Block(SpvInstruction n) => context.IAdd(u32, C(output), context.IAdd(u32,
+                    context.IMul(u32, context.UDiv(u32, n, C(MeshStage.Block)), C(stride)),
+                    context.UMod(u32, n, C(MeshStage.Block))));
+
+                SpvInstruction Vector(SpvInstruction block, int[] slots)
+                {
+                    SpvInstruction[] v = new SpvInstruction[4];
+
+                    for (int k = 0; k < 4; k++)
+                    {
+                        v[k] = slots[k] < 0
+                            ? context.Constant(f32, k == 3 ? 1f : 0f)
+                            : context.Bitcast(f32, context.Load(u32, Shared(context.IAdd(u32, block, C(slots[k] * MeshStage.Block)))));
+                    }
+
+                    return context.CompositeConstruct(vec4, v);
+                }
+
+                if (primitiveAttributes.Count != 0)
+                {
+                    Loop(count, n =>
+                    {
+                        SpvInstruction block = Block(n);
+
+                        foreach ((int attr, SpvInstruction variable) in primitiveAttributes)
+                        {
+                            context.Store(context.AccessChain(outVec4, variable, n), Vector(block, primitiveComponents[attr]));
+                        }
+                    });
+                }
+
+                Loop(C(mesh.MaxVertices), n =>
+                {
+                    SpvInstruction block = Block(n);
+
+                    if (components.TryGetValue(-1, out int[] position))
+                    {
+                        context.Store(context.AccessChain(outVec4, perVertex, n, context.Constant(context.TypeS32(), 0)), Vector(block, position));
+                    }
+
+                    foreach ((int attr, SpvInstruction variable) in attributes)
+                    {
+                        context.Store(context.AccessChain(outVec4, variable, n), Vector(block, components[attr]));
+                    }
+                });
+
+                SpvInstruction outU32 = context.TypePointer(StorageClass.Output, u32);
+
+                Loop(context.IMul(u32, count, C(3)), n =>
+                {
+                    SpvInstruction at = context.IAdd(u32, n, C(primitives + 4));
+                    SpvInstruction word = context.Load(u32, Shared(context.ShiftRightLogical(u32, at, C(2))));
+                    SpvInstruction shift = context.IMul(u32, context.BitwiseAnd(u32, at, C(3)), C(8));
+                    SpvInstruction index = context.BitwiseAnd(u32, context.ShiftRightLogical(u32, word, shift), C(0xff));
+
+                    context.Store(context.AccessChain(outU32, indices, context.UDiv(u32, n, C(3)), context.UMod(u32, n, C(3))), index);
+                });
+
+                context.Return();
+            }
+
+            context.FunctionEnd();
+
+            context.AddEntryPoint(mesh.IsTask ? SpvModule.ExecutionModelTaskEXT : SpvModule.ExecutionModelMeshEXT, entry, "main", context.GlobalVariables.ToArray());
+            context.AddExecutionMode(entry, ExecutionMode.LocalSize, (SpvLiteralInteger)mesh.Threads, (SpvLiteralInteger)1, (SpvLiteralInteger)1);
+
+            if (!mesh.IsTask)
+            {
+                context.AddExecutionMode(entry, ExecutionMode.OutputVertices, (SpvLiteralInteger)mesh.MaxVertices);
+                context.AddExecutionMode(entry, SpvModule.ExecutionModeOutputPrimitivesEXT, (SpvLiteralInteger)mesh.MaxPrimitives);
+                context.AddExecutionMode(entry, SpvModule.ExecutionModeOutputTrianglesEXT);
+            }
+        }
+
+        private static SpvInstruction FindInput(CodeGenContext context, IoVariable ioVariable)
+        {
+            foreach ((IoDefinition definition, SpvInstruction variable) in context.Inputs)
+            {
+                if (definition.IoVariable == ioVariable)
+                {
+                    return variable;
+                }
+            }
+
+            throw new InvalidOperationException($"task or mesh shader without the {ioVariable} input");
+        }
+    }
+}
