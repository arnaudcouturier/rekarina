+using System.Collections.Generic;
+using static Spv.Specification;
+
+namespace Spv.Generator
+{
+    // TOTK: the SPV_EXT_mesh_shader pieces the generated grammar (2021) does not have, for NVN2 task and mesh shaders
+    // (Ryujinx.Graphics.Shader CodeGen/Spirv/MeshStage.cs). Values from the SPIR-V registry's unified1 spirv.core.grammar.json.
+    public partial class Module
+    {
+        public const ExecutionModel ExecutionModelTaskEXT = (ExecutionModel)5364;
+        public const ExecutionModel ExecutionModelMeshEXT = (ExecutionModel)5365;
+        public const Capability CapabilityMeshShadingEXT = (Capability)5283;
+        public const StorageClass StorageClassTaskPayloadWorkgroupEXT = (StorageClass)5402;
+        public const BuiltIn BuiltInPrimitiveTriangleIndicesEXT = (BuiltIn)5296;
+        public const ExecutionMode ExecutionModeOutputPrimitivesEXT = (ExecutionMode)5270;
+        public const ExecutionMode ExecutionModeOutputTrianglesEXT = (ExecutionMode)5298;
+        private const Op OpEmitMeshTasksEXT = (Op)5294;
+        private const Op OpSetMeshOutputsEXT = (Op)5295;
+
+        // Every global variable declared so far: a SPIR-V 1.4 entry point lists all the global variables it uses.
+        public IReadOnlyList<Instruction> GlobalVariables => _globals;
+
+        public Instruction EmitMeshTasksEXT(Instruction groupCountX, Instruction groupCountY, Instruction groupCountZ, Instruction payload)
+        {
+            Instruction result = NewInstruction(OpEmitMeshTasksEXT);
+
+            result.AddOperand(groupCountX);
+            result.AddOperand(groupCountY);
+            result.AddOperand(groupCountZ);
+            result.AddOperand(payload);
+            AddToFunctionDefinitions(result);
+
+            return result;
+        }
+
+        public Instruction SetMeshOutputsEXT(Instruction vertexCount, Instruction primitiveCount)
+        {
+            Instruction result = NewInstruction(OpSetMeshOutputsEXT);
+
+            result.AddOperand(vertexCount);
+            result.AddOperand(primitiveCount);
+            AddToFunctionDefinitions(result);
+
+            return result;
+        }
+    }
