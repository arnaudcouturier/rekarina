+        // The constant buffer slots (bit n: slot n) the whole shader reads, through a load or as a direct operand.
+        private static int ConstantSlotsRead(BasicBlock[] blocks, ResourceManager resourceManager)
+        {
+            int slots = 0;
+
+            foreach (BasicBlock block in blocks)
+            {
+                foreach (INode n in block.Operations)
+                {
+                    if (n is Operation op && op.Inst == Instruction.Load && op.StorageKind == StorageKind.ConstantBuffer &&
+                        op.GetSource(0).Type == OperandType.Constant &&
+                        resourceManager.TryGetConstantBufferSlot(op.GetSource(0).Value, out int slot))
+                    {
+                        slots |= 1 << slot;
+                    }
+
+                    for (int s = 0; s < n.SourcesCount; s++)
+                    {
+                        Operand src = n.GetSource(s);
+
+                        if (src != null && src.Type == OperandType.ConstantBuffer)
+                        {
+                            slots |= 1 << src.GetCbufSlot();
+                        }
+                    }
+                }
+            }
+
+            return slots;
+        }
