+            int words = mesh.Size / 4;
+            int input = mesh.Offsets[1] / 4, output = mesh.Offsets[2] / 4, primitives = mesh.Offsets[3];
+
+            // a pointer to a 32-bit word of the emulation buffer, by its word number, and a load of one
+            SpvInstruction Word(SpvInstruction word) =>
+                context.ConvertUToPtr(physPtr, context.IAdd(u64, baseAddress, context.UConvert(u64, context.IMul(u32, word, C(4)))));
+
+            SpvInstruction Get(SpvInstruction word)
+            {
+                SpvInstruction load = context.Load(u32, Word(word), MemoryAccessMask.Aligned);
+                load.AddOperand((SpvLiteralInteger)4);
+                return load;
+            }
+
+            // the workgroup returns here when the condition holds (the same in all its threads, so before any barrier)
+            void ReturnIf(SpvInstruction condition)
+            {
+                SpvInstruction leave = context.Label();
+                SpvInstruction merge = context.Label();
+
+                context.SelectionMerge(merge, SelectionControlMask.MaskNone);
+                context.BranchConditional(condition, leave, merge);
+                context.AddLabel(leave);
+                context.Return();
+                context.AddLabel(merge);
+            }
