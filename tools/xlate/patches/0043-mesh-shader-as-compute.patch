+            if (mesh.IsTask)
+            {
+                // A task workgroup t keeps its payload (output words 0 ..) and its launch count (output word 1, at most EmuTaskLaunches) for
+                // the mesh kernel, which runs EmuTaskLaunches x tasks workgroups; workgroup 0 writes those dispatch arguments.
+                int maxTasks = mesh.EmuMaxTasks();
+
+                Loop(C(words), i => context.Store(Shared(i), C(0)));
+                Barrier();
+
+                context.FunctionCall(voidType, body);
+                Barrier();
+
+                If(context.LogicalAnd(boolType, context.IEqual(boolType, group, C(0)), first), () =>
+                {
+                    Put(C(MeshStage.EmuMeshArgsOffset / 4), C(MeshStage.EmuTaskLaunches));
+                    Put(C(MeshStage.EmuMeshArgsOffset / 4 + 1), context.GlslUMin(u32, groups, C(maxTasks)));
+                    Put(C(MeshStage.EmuMeshArgsOffset / 4 + 2), C(1));
+                });
+
+                ReturnIf(context.UGreaterThanEqual(boolType, group, C(maxTasks)));
+
+                SpvInstruction payloadBase = context.IAdd(u32, C(MeshStage.EmuPayloadOffset / 4), context.IMul(u32, group, C(Math.Max(mesh.PayloadWords, 1))));
+
+                Loop(C(mesh.PayloadWords), i => Put(context.IAdd(u32, payloadBase, i), context.Load(u32, Shared(context.IAdd(u32, C(output), i)))));
+
+                If(first, () => Put(context.IAdd(u32, C(MeshStage.EmuLaunchOffset / 4), group),
+                    context.GlslUMin(u32, context.Load(u32, Shared(C(output + 1))), C(MeshStage.EmuTaskLaunches))));
+
+                context.Return();
+                context.FunctionEnd();
+
+                context.AddEntryPoint(ExecutionModel.GLCompute, entry, "main", context.GlobalVariables.ToArray());
+                context.AddExecutionMode(entry, ExecutionMode.LocalSize, (SpvLiteralInteger)mesh.Threads, (SpvLiteralInteger)1, (SpvLiteralInteger)1);
+                return;
+            }
+
+            // the meshlet this workgroup writes
+            SpvInstruction meshlet;
+
+            if (mesh.HasTask)
+            {
+                // Under a task: workgroup (j, t) is launch j of task t, idle past that task's launch count. Its stage memory takes the task's
+                // payload; its slot in the buffer is the next free one (a counter at EmuCounterOffset, zeroed by the runtime), so idle launches
+                // take no room, and the draw's index count follows the highest slot taken.
+                SpvInstruction task = context.CompositeExtract(u32, context.Load(uvec3, groupVariable), 1);
+
+                ReturnIf(context.UGreaterThanEqual(boolType, group, Get(context.IAdd(u32, C(MeshStage.EmuLaunchOffset / 4), task))));
+
+                Loop(C(words), i => context.Store(Shared(i), C(0)));
+                Barrier();
+
+                SpvInstruction payloadBase = context.IAdd(u32, C(MeshStage.EmuPayloadOffset / 4), context.IMul(u32, task, C(Math.Max(mesh.PayloadWords, 1))));
+
+                Loop(C(mesh.PayloadWords), i => context.Store(Shared(context.IAdd(u32, C(input), i)), Get(context.IAdd(u32, payloadBase, i))));
+                Barrier();
+
+                context.FunctionCall(voidType, body);
+                Barrier();
+
+                // word 0 of the stage memory (the workgroup's number, read by the kernel only) carries the slot to every thread
