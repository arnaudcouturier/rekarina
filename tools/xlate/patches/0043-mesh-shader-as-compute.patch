+                        SpvInstruction shift = context.IMul(u32, context.BitwiseAnd(u32, at, C(3)), C(8));
+                        index[k] = context.BitwiseAnd(u32, context.ShiftRightLogical(u32, word, shift), C(0xff));
+                        live = context.LogicalAnd(boolType, live, context.ULessThan(boolType, index[k], C(mesh.MaxVertices)));
+                    }
