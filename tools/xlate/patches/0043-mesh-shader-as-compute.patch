+            context.Return();
+            context.FunctionEnd();
+
+            context.AddEntryPoint(ExecutionModel.GLCompute, entry, "main", context.GlobalVariables.ToArray());
+            context.AddExecutionMode(entry, ExecutionMode.LocalSize, (SpvLiteralInteger)mesh.Threads, (SpvLiteralInteger)1, (SpvLiteralInteger)1);
+        }
