+        // TOTK: a mesh shader for a GPU without VK_EXT_mesh_shader (MeshStage.AsCompute; runtime vk_exec_draw.c mesh_emulate): a compute kernel,
+        // one workgroup a meshlet, that runs the stage as the mesh entry point does and writes what that would hand to Vulkan into the
+        // emulation buffer, which an indexed draw then reads as a vertex and an index buffer:
+        //   header (byte 0): VkDrawIndexedIndirectCommand {min(workgroups, the most that fit) x MaxPrimitives x 3, 1, 0, 0, 0}, by workgroup 0;
+        //   vertices (byte MeshStage.EmuVertexOffset): meshlet m's vertex v at vec4 (m x MaxVertices + v) x (1 + attributes): the position,
+        //     then each generic attribute in location order (a component the shader does not have is 0, w 1);
+        //   indices (byte MeshStage.EmuIndexOffset): meshlet m's triangle p at word (m x MaxPrimitives + p) x 3, each the vertex's number in
+        //     the vertex buffer; a triangle past the meshlet's count, or naming a vertex past its MaxVertices, is its first vertex
+        //     three times (degenerate, nothing drawn).
+        // A meshlet past the most that fit writes nothing. The buffer's address is two constants (MeshStage.EmuAddressLo, Hi) the runtime
+        // replaces before it builds the pipeline. Triangles only, without per-primitive attributes (Program.cs refuses others).
+        // Under a task the draw takes two kernels: the task's (IsTask), one workgroup a task workgroup, keeps each one's payload and launch
+        // count in the buffer (MeshStage.EmuPayloadOffset, EmuLaunchOffset) and writes the mesh kernel's dispatch arguments
+        // ({EmuTaskLaunches, tasks, 1} at EmuMeshArgsOffset); the mesh shader's (HasTask), workgroup (j, t) for launch j of task t, idle past
+        // that task's count, takes the next meshlet slot from a counter (EmuCounterOffset) and raises the draw's index count to cover it
+        // (atomic max); the runtime zeroes the arguments and the counter first.
+        private static void GenerateAsCompute(CodeGenContext context, SpvInstruction body, MeshStage mesh, SpvInstruction shared)
+        {
+            SpvInstruction u32 = context.TypeU32();
+            SpvInstruction u64 = context.TypeInt(64, 0);
+            SpvInstruction uvec2 = context.TypeVector(u32, 2);
+            SpvInstruction uvec3 = context.TypeVector(u32, 3);
+            SpvInstruction boolType = context.TypeBool();
+            SpvInstruction voidType = context.TypeVoid();
+            SpvInstruction sharedPtr = context.TypePointer(StorageClass.Workgroup, u32);
+            SpvInstruction physPtr = context.TypePointer(StorageClass.PhysicalStorageBuffer, u32);
+            SpvInstruction C(int v) => context.Constant(u32, v);
+
+            // component index in the attribute area of attribute a (-1: the position), x..w (as Generate)
+            Dictionary<int, int[]> components = new();
+
+            for (int i = 0; i < mesh.VertexComponents.Length; i++)
+            {
+                int c = mesh.VertexComponents[i];
+
+                if (c <= MeshStage.PointSize)
+                {
+                    continue;
+                }
+
+                int attr = c < 0 ? -1 : c >> 2;
+                int comp = c < 0 ? -1 - c : c & 3;
+
+                if (!components.TryGetValue(attr, out int[] slots))
+                {
+                    components[attr] = slots = [-1, -1, -1, -1];
+                }
+
+                slots[comp] = i;
+            }
+
+            int[] attrs = components.Keys.Where(a => a >= 0).OrderBy(a => a).ToArray();
+            int vec4s = 1 + attrs.Length;
+            int maxMeshlets = mesh.IsTask ? 0 : mesh.EmuMaxMeshlets(vec4s);   // a task writes no meshlets
+
+            SpvInstruction lidVariable = FindInput(context, IoVariable.ThreadId);
+            SpvInstruction groupVariable = FindInput(context, IoVariable.CtaId);
+            SpvInstruction countVariable = context.Variable(context.TypePointer(StorageClass.Input, uvec3), StorageClass.Input);
+            context.Decorate(countVariable, Decoration.BuiltIn, (SpvLiteralInteger)BuiltIn.NumWorkgroups);
+            context.AddGlobalVariable(countVariable);
+            context.Name(countVariable, "workgroups");
+
+            SpvInstruction functionType = context.TypeFunction(voidType, false);
+            SpvInstruction entry = context.Function(voidType, FunctionControlMask.MaskNone, functionType);
+            context.AddFunction(entry);
+            context.AddLabel(context.Label());
+
+            SpvInstruction counter = context.Variable(context.TypePointer(StorageClass.Function, u32), StorageClass.Function);
+            context.AddLocalVariable(counter);
+
+            SpvInstruction lid = context.CompositeExtract(u32, context.Load(uvec3, lidVariable), 0);
+            SpvInstruction group = context.CompositeExtract(u32, context.Load(uvec3, groupVariable), 0);
+            SpvInstruction groups = context.CompositeExtract(u32, context.Load(uvec3, countVariable), 0);
+            SpvInstruction baseAddress = context.Bitcast(u64, context.CompositeConstruct(uvec2,
+                context.Constant(u32, unchecked((int)MeshStage.EmuAddressLo)), context.Constant(u32, unchecked((int)MeshStage.EmuAddressHi))));
+
+            SpvInstruction Shared(SpvInstruction wordIndex) => context.AccessChain(sharedPtr, shared, wordIndex);
+
+            // a 32-bit word of the emulation buffer, by its word number
+            void Put(SpvInstruction word, SpvInstruction value)
+            {
+                SpvInstruction address = context.IAdd(u64, baseAddress, context.UConvert(u64, context.IMul(u32, word, C(4))));
+                SpvInstruction store = context.Store(context.ConvertUToPtr(physPtr, address), value, MemoryAccessMask.Aligned);
+                store.AddOperand((SpvLiteralInteger)4);
+            }
+
+            void Barrier()
+            {
+                context.ControlBarrier(
+                    context.Constant(u32, Scope.Workgroup),
+                    context.Constant(u32, Scope.Workgroup),
+                    context.Constant(u32, MemorySemanticsMask.WorkgroupMemory | MemorySemanticsMask.AcquireRelease));
+            }
+
+            void If(SpvInstruction condition, Action then)
+            {
+                SpvInstruction thenLabel = context.Label();
+                SpvInstruction merge = context.Label();
+
+                context.SelectionMerge(merge, SelectionControlMask.MaskNone);
+                context.BranchConditional(condition, thenLabel, merge);
+                context.AddLabel(thenLabel);
+                then();
+                context.Branch(merge);
+                context.AddLabel(merge);
+            }
+
+            // for (i = lid; i < end; i += threads) body(i)
+            void Loop(SpvInstruction end, Action<SpvInstruction> loopBody)
+            {
+                context.Store(counter, lid);
+
+                SpvInstruction header = context.Label();
+                SpvInstruction check = context.Label();
+                SpvInstruction bodyLabel = context.Label();
+                SpvInstruction next = context.Label();
+                SpvInstruction merge = context.Label();
+
+                context.Branch(header);
+                context.AddLabel(header);
+                context.LoopMerge(merge, next, LoopControlMask.MaskNone);
+                context.Branch(check);
+                context.AddLabel(check);
+                SpvInstruction i = context.Load(u32, counter);
+                context.BranchConditional(context.ULessThan(boolType, i, end), bodyLabel, merge);
+                context.AddLabel(bodyLabel);
+                loopBody(context.Load(u32, counter));
+                context.Branch(next);
+                context.AddLabel(next);
+                context.Store(counter, context.IAdd(u32, context.Load(u32, counter), C(mesh.Threads)));
+                context.Branch(header);
+                context.AddLabel(merge);
+            }
