         private static Operand ALaneId(EmitterContext context) => EmitLoadSubgroupLaneId(context);
 
+        // TOTK: on a host whose subgroups are wider than the warp (AMD GCN runs compute 64 lanes wide), a shuffle's index is a
+        // lane of the subgroup, so lane numbers 0..31 named the first warp's lanes for every warp in it: the second warp of
+        // each subgroup took the first one's REDUX sums and MATCH masks (the game's culling kernels count their lists so).
+        // AWarpFirst is the subgroup lane of this lane's warp's lane 0, AWarpLane the subgroup lane of lane `lane` of this
+        // lane's warp, AWarpActive the warp's 32 bits of the active lanes. Compute only: there a workgroup of more than 32
+        // threads shares a subgroup between warps; the game's task and mesh workgroups are 32 threads, one warp each.
+        // With 32 lanes, or in another stage, AWarpFirst is null and nothing changes: those translate as before.
+        private static Operand AWarpFirst(EmitterContext context)
+        {
+            if (context.TranslatorContext.GpuAccessor.QueryHostSubgroupSize() <= 32 ||
+                context.TranslatorContext.Definitions.Stage != ShaderStage.Compute)
+            {
+                return null;
+            }
+
+            return context.BitwiseAnd(context.Load(StorageKind.Input, IoVariable.SubgroupLaneId), Const(~31));
+        }
+
+        private static Operand AWarpLane(EmitterContext context, Operand first, Operand lane)
+        {
+            return first == null ? lane : context.BitwiseOr(first, lane);
+        }
+
+        private static Operand AWarpActive(EmitterContext context, Operand first)
+        {
+            return first == null ? context.Ballot(Const(IrConsts.True), 0) : EmitBallot(context, Const(IrConsts.True));
+        }
+
         private static Operand AGpr(int r) => r >= RegisterConsts.RegisterZeroIndex ? Const(0) : Register(r, RegisterType.Gpr);
 
