+        private static OperationResult GenerateMatrixMultiplyAddShared(CodeGenContext context, AstOperation operation)
+        {
+            if (!context.UsesCooperativeMatrix)
+            {
+                context.UsesCooperativeMatrix = true;
+                context.AddCapability(Capability.CooperativeMatrixNV);
+                context.AddCapability(Capability.Float16);
+                context.AddExtension("SPV_NV_cooperative_matrix");
+            }
+
+            int id = ((AstOperand)operation.GetSource(0)).Value;
+            SpvInstruction shared = context.SharedMemories[id];
+            SpvInstruction u32 = context.TypeU32();
+            SpvInstruction block = context.Get(AggregateType.U32, operation.GetSource(1));
+            SpvInstruction C(int v) => context.Constant(u32, v);
