+            SpvInstruction pa = context.AccessChain(ptrType, shared, block);
+            SpvInstruction pb = context.AccessChain(ptrType, shared, context.IAdd(u32, block, C(128)));
+            SpvInstruction pc = context.AccessChain(ptrType, shared, context.IAdd(u32, block, C(192)));
+            SpvInstruction a = context.CooperativeMatrixLoadNV(matA, pa, C(8), rowMajor);
+            SpvInstruction b = context.CooperativeMatrixLoadNV(matB, pb, C(8), colMajor);
+            SpvInstruction c = context.CooperativeMatrixLoadNV(matC, pc, C(4), rowMajor);
+            SpvInstruction d = context.CooperativeMatrixMulAddNV(matC, a, b, c);
+            context.CooperativeMatrixStoreNV(pc, d, C(4), rowMajor);
+
+            return OperationResult.Invalid;
+        }
 
