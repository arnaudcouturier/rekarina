+    /// SPIR-V entry point around it (CodeGen/Spirv/MeshStageWrapper.cs) fills the stage inputs and hands the outputs to Vulkan, as
+    /// nxnative's dm/gfx/tools/dmsh_meshstage.py does for Metal (MIT).
+    /// </summary>
+    public sealed class MeshStage
+    {
+        /// <summary>True for a task shader, false for a mesh shader.</summary>
+        public bool IsTask { get; init; }
+
+        /// <summary>A mesh shader launched by a task shader: its input is the task's payload.</summary>
+        public bool HasTask { get; init; }
+
+        /// <summary>Threads of a workgroup (control +0x58).</summary>
+        public int Threads { get; init; }
+
+        /// <summary>The payload's 32-bit words (control +0x5a, bytes, rounded up).</summary>
+        public int PayloadWords { get; init; }
+
+        /// <summary>A mesh shader's most vertices and primitives (control +0x60, +0x62).</summary>
+        public int MaxVertices { get; init; }
+        public int MaxPrimitives { get; init; }
+
+        /// <summary>
+        /// The components of the attribute area, in its order (the SPH's OMAP): -1 - c for the position's component c,
+        /// 4 n + c for generic attribute n's, PointSize for the point size and Unused for a system value the entry point
+        /// hands to nothing (it still takes its block).
+        /// </summary>
+        public int[] VertexComponents { get; init; }
+        public const int PointSize = -5;
+        public const int Unused = -6;
+
+        /// <summary>Vertices of a primitive (control +0x5f): 3 triangles, 2 lines, 1 points; an index byte each.</summary>
+        public int PrimitiveVertices { get; init; } = 3;
+
+        /// <summary>
+        /// A primitive's index vector is stored whole, by the thread whose number is the primitive's. Otherwise thread n stores
+        /// index byte n, so the components of a triangle's vector come from three threads: AMD's Windows driver for RDNA 1 and 2
+        /// loses such stores, and every mesh draw comes out empty.
+        /// </summary>
+        public bool WholeIndices { get; init; }
+
+        /// <summary>
+        /// TOTK: a mesh shader of 60,000 to 70,000 bytes of instructions (the code file, SPH included; runtime nvn_ctl.h
+        /// nvn2_ctl_mesh_large). Its raw global-memory helpers are not inlined (SpirvGenerator.Generate).
+        /// </summary>
+        public bool Large { get; init; }
+
+        /// <summary>
+        /// A mesh shader's per-primitive components (the second SPH's OMAP), 4 n + c for generic attribute n's; they follow the vertex components
+        /// in each attribute block.
+        /// </summary>
+        public int[] PrimitiveComponents { get; init; } = System.Array.Empty<int>();
+
+        /// <summary>Byte offsets in the stage memory: the workgroup's number, the input, the outputs, the primitive bytes.</summary>
+        public int[] Offsets { get; init; }
+
+        /// <summary>The stage memory's bytes.</summary>
+        public int Size { get; init; }
+
+        /// <summary>The constant buffer 0 byte offset where the host puts the draw's first workgroup.</summary>
+        public int FirstWorkgroupOffset { get; init; }
+
+        /// <summary>Set by the translator: the shared memory that holds the stage memory.</summary>
+        public int SharedMemoryId { get; set; } = -1;
+
+        /// <summary>Vertices and primitives of an attribute block.</summary>
+        public const int Block = 32;
+
+        /// <summary>
+        /// TOTK: a mesh shader for a GPU without VK_EXT_mesh_shader: a compute kernel that writes what the mesh entry point would hand to
+        /// Vulkan into the emulation buffer (CodeGen/Spirv/MeshStageWrapper.cs GenerateAsCompute; runtime vk_exec_draw.c mesh_emulate).
+        /// </summary>
+        public bool AsCompute { get; init; }
+
+        /// <summary>The emulation buffer (runtime/vk.h VK_MESH_EMU_*, which must match): its bytes; the draw's arguments at 0; under a task the
+        /// mesh kernel's dispatch arguments, the meshlets taken (a counter) and each task's launch count and payload; then the vertices
+        /// and the indices; and the two 32-bit constants that stand for its address in the module until the runtime puts the address
+        /// there.</summary>
+        public const int EmuBytes = 64 << 20;
+        public const int EmuMeshArgsOffset = 32;
+        public const int EmuCounterOffset = 48;
+        public const int EmuLaunchOffset = 4 << 10;
+        public const int EmuPayloadOffset = 64 << 10;
+        public const int EmuVertexOffset = 8 << 20;
+        public const int EmuIndexOffset = 48 << 20;
+        public const uint EmuAddressLo = 0xC0DE5A71, EmuAddressHi = 0xC0DE5A72;
+
+        /// <summary>The most mesh workgroups one task workgroup launches in the emulation (more are dropped): the mesh kernel runs this many
+        /// per task, the idle ones returning at once.</summary>
+        public const int EmuTaskLaunches = 64;
+
+        /// <summary>The task workgroups whose launch counts and payloads the emulation buffer holds.</summary>
+        public int EmuMaxTasks() => System.Math.Max(1, System.Math.Min((EmuPayloadOffset - EmuLaunchOffset) / 4,
+            (EmuVertexOffset - EmuPayloadOffset) / (System.Math.Max(PayloadWords, 1) * 4)));
+
+        /// <summary>The meshlets the emulation buffer holds when each vertex takes vec4s vec4s.</summary>
+        public int EmuMaxMeshlets(int vec4s)
+        {
+            int byVertices = (EmuIndexOffset - EmuVertexOffset) / (MaxVertices * vec4s * 16);
+            int byIndices = (EmuBytes - EmuIndexOffset) / (MaxPrimitives * 3 * 4);
+            return System.Math.Max(1, System.Math.Min(byVertices, byIndices));
+        }
+    }
+}
