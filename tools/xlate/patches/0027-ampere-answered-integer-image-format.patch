+        // TOTK: an Ampere formatted surface load or store (SULD.P, SUST.P) of an image the host says is viewed with an integer format
+        // (IGpuAccessor.QueryAnsweredImageFormat) declares the image with that format, so the registers are read and written as raw bits
+        // as the hardware does through such a view. Without it the image is declared without a format, float, and the bits were
+        // converted: OoT's forest cutscene writes shared-exponent colour words through an NVN R32UI view of an R11G11B10F
+        // texture (a335c1db6270c355), and they came out as red, clamped and NaN
+        private static TextureFormat AnsweredIntegerFormat(EmitterContext context, int handle, int cbufSlot, TextureFormat format)
+        {
+            if (format != TextureFormat.Unknown || !context.TranslatorContext.Options.Flags.HasFlag(TranslationFlags.Ampere))
+            {
+                return format;
+            }
+
+            TextureFormat answered = context.TranslatorContext.GpuAccessor.QueryAnsweredImageFormat(handle, cbufSlot);
+
+            return answered != TextureFormat.Unknown && answered.GetComponentType() != AggregateType.FP32 ? answered : format;
+        }
