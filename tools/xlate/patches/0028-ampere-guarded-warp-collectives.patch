+        // Ampere instructions that exchange values between the lanes of a warp: VOTE, VOTEU, SHFL, MATCH and REDUX
+        private static bool IsWarpCollective(int opcode)
+        {
+            return opcode is 0x806 or 0x886 or 0x389 or 0x589 or 0x989 or 0xf89 or 0x3a1 or 0x3c4;
+        }
+
+        // A guarded warp-collective instruction (EmitOpsAmpere): the hardware takes every active lane's operands, and the guard
+        // only decides which lanes' destinations are written. The operations emitted for it from opStart on run unguarded and
+        // write fresh locals (one per write, later reads of the register in the range read the local); after them, the lanes
+        // whose guard holds copy the locals to the registers. Emitted as `if (guard) { op }`, the vote saw only those lanes:
+        // the NVN2 compiler's warp-aggregated atomics take a VOTEU under the leader lane's guard to count the lanes it adds for
+        // (VOTEU, POPC, ATOM), so OoT's foliage culling kernel (fe89d4116c26fddf) counted one instance per warp,
+        // the other lanes wrote their instances over the next warps' slots, and the mesh draws' counts and lists changed from
+        // frame to frame: trees, bushes and grass flickered and vanished with the camera still.
+        private static void GuardWarpWrites(EmitterContext context, int opStart, Operand guard, bool guardInv)
+        {
+            int end = context.OperationsCount;
+            Dictionary<Register, Operand> locals = new();
+
+            for (int i = opStart; i < end; i++)
+            {
+                Operation operation = context.GetOperation(i);
+
+                for (int s = 0; s < operation.SourcesCount; s++)
+                {
+                    Operand src = operation.GetSource(s);
+
+                    if (src != null && src.Type == OperandType.Register && locals.TryGetValue(src.GetRegister(), out Operand local))
+                    {
+                        operation.SetSource(s, local);
+                    }
+                }
+
+                for (int d = 0; d < operation.DestsCount; d++)
+                {
+                    Operand dest = operation.GetDest(d);
+
+                    if (dest != null && dest.Type == OperandType.Register)
+                    {
+                        Operand local = Local();
+
+                        locals[dest.GetRegister()] = local;
+                        operation.SetDest(d, local);
+                    }
+                }
+            }
+
+            if (locals.Count == 0)
+            {
+                return;
+            }
+
+            Operand skip = Label();
+
+            if (guardInv)
+            {
+                context.BranchIfTrue(skip, guard);
+            }
+            else
+            {
+                context.BranchIfFalse(skip, guard);
+            }
+
+            foreach ((Register reg, Operand local) in locals)
+            {
+                context.Copy(Register(reg), local);
+            }
+
+            context.MarkLabel(skip);
+        }
